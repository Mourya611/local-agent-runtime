# ==============================================================================
# LOCAL MODE CONFIGURATION (Default)
# ==============================================================================
AGENT_MODE=local

# LLM API Credentials
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# Search API Credentials
TAVILY_API_KEY=your_tavily_api_key_here

# Local Development Ports
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_PORT=3000
CORS_ORIGINS=http://localhost:3000

# Chrome Remote Debugging CDP URL
CHROME_CDP_URL=http://127.0.0.1:9222


# ==============================================================================
# PUBLIC DEMO BACKEND CONFIGURATION (Render / Cloud Deployment)
# ==============================================================================
# AGENT_MODE=public
# CORS_ORIGINS=https://your-agent.vercel.app
# MAX_TASK_DURATION_SECONDS=120
# MAX_TOOL_CALLS_PER_TASK=20
# MAX_SEARCHES_PER_TASK=8
# MAX_LLM_CALLS_PER_TASK=10
# MAX_CONCURRENT_PUBLIC_TASKS=3
# RATE_LIMIT_REQUESTS_PER_MIN=5
# PUBLIC_ARTIFACT_RETENTION_HOURS=24
